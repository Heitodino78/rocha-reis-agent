# Configuração exclusivamente local. Nenhuma credencial REAL é necessária até a Fase 4.
# Variáveis do processo têm precedência sobre este arquivo.
APP_ENV=local
APP_NAME=rocha-reis-agent

# Limites do simulador; não são uma política aprovada de retenção para produção.
SIM_MAX_MESSAGE_CHARS=2000
SIM_MAX_HISTORY_ENTRIES=100
SIM_MAX_EVENTS_PER_SESSION=1000
SIM_MAX_CONVERSATIONS=100
SIM_CONTEXT_TURNS=5

# Somente fake local está autorizado. O timeout é um contrato para adaptadores.
AI_PROVIDER=fake
AI_HISTORY_LIMIT=4
AI_TIMEOUT_SECONDS=2
# Ausente: usar a versão ativa em prompts/registry.json.
# AI_PROMPT_VERSION=v1

# Fase 8 — provedor generativo REAL (Anthropic). BLOQUEADO pela constante de código
# AI_REAL_PROVIDER_ACTIVATION_AUTHORIZED=False (config.py): com ela falsa, AI_PROVIDER=anthropic
# é RECUSADO na inicialização, com ou sem chave. Uma chave sozinha nunca ativa nada, e esta
# trava é independente das travas da Meta. Ativação exige revisão de código + autorização
# escrita (ver STATUS_FASE_8.md §23). NUNCA grave uma chave real neste arquivo.
# AI_PROVIDER=anthropic
# AI_API_KEY=            # gerenciador de segredos; exclusiva, diferente dos segredos do canal
# AI_PROMPT_VERSION=v2   # obrigatória com o provedor real (contrato ai-response-v2)
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium                 # low | medium | high (thinking é sempre ligado no Opus 5.5)
# AI_MAX_OUTPUT_TOKENS=4096        # inclui tokens de raciocínio
# AI_MAX_RETRIES=1
# AI_REFUSAL_FALLBACK=default      # fallback server-side em recusa; "off" desliga
# AI_MAX_CONCURRENCY=2
# AI_MAX_REQUESTS_PER_DAY=500
# AI_MAX_COST_USD_PER_DAY=5        # ESTIMATIVA pela tabela ai/pricing.json; não é fatura
# AI_MAX_INPUT_CHARS=6000

# Fase 8 — conhecimento: "file" (fixtures sintéticas, padrão) ou "database" (gestão e
# aprovação pelo painel; exige SQLite e `admin_cli knowledge-init`).
# KNOWLEDGE_SOURCE=file
# Exigir que a aprovação seja feita por outro administrador (quatro olhos).
# KNOWLEDGE_REQUIRE_DISTINCT_APPROVER=false

# Memória preserva modo anterior. SQLite exige caminho explícito e volume com 0600.
# NÃO use o volume do projeto (vfat: permissões sempre 0644) nem /tmp (tmpfs: some
# ao reiniciar o sistema). Caminho durável sugerido: diretório 0700 no $HOME (ext4).
STORAGE_BACKEND=memory
# STORAGE_BACKEND=sqlite
# STORAGE_PATH=/home/USUARIO/.local/share/rocha-reis-agent/dev.synthetic.sqlite3
STORAGE_BUSY_TIMEOUT_MS=1000
STORAGE_MAX_BYTES=67108864
# Prazos locais fictícios; não são política legal para clientes reais.
# A limpeza de conteúdo exige /purge PURGE_SYNTHETIC; não há agendador.
STORAGE_RETENTION_DAYS=7
STORAGE_AUDIT_DAYS=30
STORAGE_AUDIT_LIMIT=10000
# Ao atingir SIM_MAX_CONVERSATIONS ativas, arquiva a conversa ociosa há este tempo
# (sem humano em atendimento e sem envio pendente/incerto). Não apaga dados.
STORAGE_ARCHIVE_IDLE_HOURS=24

# ---- Canal WhatsApp (Fases 4–5) — SOMENTE OFFLINE, transporte fake ----------
# Desligado por padrão: nenhuma rota de webhook é criada. Exige STORAGE_BACKEND=sqlite.
WHATSAPP_ENABLED=false
# "graph" (HTTP real) é RECUSADO nesta fase pela trava de código
# GRAPH_TRANSPORT_ACTIVATION_AUTHORIZED=False, mesmo com todas as variáveis abaixo.
WHATSAPP_TRANSPORT=fake
# Três segredos DISTINTOS, 32+ caracteres, gerados localmente, por exemplo:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Verify Token: usado apenas no GET de verificação (hub.verify_token).
# App Secret: chave do HMAC X-Hub-Signature-256. NÃO é o Verify Token nem o token de acesso.
# Conversation key: pseudonimiza o remetente (HMAC). Trocar a chave cria novas conversas.
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_CONVERSATION_KEY=
# IDs numéricos fictícios para ensaio local (não são IDs reais da Meta):
# WHATSAPP_PHONE_NUMBER_ID=100000000000001
# WHATSAPP_BUSINESS_ACCOUNT_ID=200000000000002
# Transporte real (futuro, após autorização): versão explícita e token exclusivo.
# v26.0 era a versão mais recente listada pela Meta em 19/11/2026; reconfirmar antes de ativar.
# O token NUNCA deve ser gravado neste arquivo versionado; use um gerenciador de segredos.
# WHATSAPP_GRAPH_API_VERSION=v26.0
# WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CONNECT_TIMEOUT_SECONDS=5
# Interrupção emergencial por configuração (só bloqueia; ver local_cli halt/resume-dispatch).
CHANNEL_DISPATCH_HALTED=false
# Log técnico privado (0600, fora do volume vfat), sem dados pessoais.
# CHANNEL_LOG_PATH=/home/USUARIO/.local/share/rocha-reis-agent/logs/canal.log

# ---- Homologação (Fase 6) — ver docs/HOMOLOGACAO_META_FASE6.md ----------------
# APP_ENV=homologation exige banco *.homolog.synthetic.sqlite3 e arquivo de autorização
# privado (0600) preenchido pelo responsável. Envio real continua bloqueado no código.
# APP_ENV=homologation
# STORAGE_PATH=/home/USUARIO/.local/share/rocha-reis-agent/homolog/ensaio.homolog.synthetic.sqlite3
# HOMOLOG_AUTHORIZATION_FILE=/home/USUARIO/.local/share/rocha-reis-agent/homolog/autorizacao.json
WHATSAPP_MAX_BODY_BYTES=262144
WHATSAPP_SEND_TIMEOUT_SECONDS=10
CHANNEL_INBOX_LEASE_SECONDS=60
CHANNEL_INBOX_MAX_ATTEMPTS=5
CHANNEL_OUTBOX_LEASE_SECONDS=30
CHANNEL_OUTBOX_MAX_ATTEMPTS=3
CHANNEL_BACKOFF_BASE_SECONDS=2
CHANNEL_BACKOFF_MAX_SECONDS=300
# Margem de segurança sob a janela de atendimento de 24h.
CHANNEL_SERVICE_WINDOW_HOURS=23

# ---- Painel de atendimento humano (Fase 7) — SOMENTE LOCAL -------------------
# App separada do webhook. Exige STORAGE_BACKEND=sqlite e WHATSAPP_ENABLED=true.
# Executar: uvicorn rocha_reis_agent.panel.app:create_panel_app --factory \
#   --host 127.0.0.1 --port 8000 --no-access-log --timeout-graceful-shutdown 5
PANEL_ENABLED=false
PANEL_ORIGIN=http://127.0.0.1:8000
# Cookie Secure é o padrão. "false" só é aceito com origem http em 127.0.0.1/localhost.
PANEL_COOKIE_SECURE=true
PANEL_SESSION_IDLE_MINUTES=30
PANEL_SESSION_ABSOLUTE_HOURS=12
PANEL_LOGIN_MAX_FAILURES=5
PANEL_LOGIN_WINDOW_MINUTES=15
PANEL_PAGE_SIZE=25
PANEL_SSE_POLL_SECONDS=1
PANEL_SSE_MAX_SECONDS=60
# Worker embutido com transporte FAKE (demonstração local integrada).
PANEL_EMBEDDED_WORKER=false
