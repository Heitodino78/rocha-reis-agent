# REFERÊNCIA (Fase 13) — não instalado. Backup diário às 03:15 (com variação de até 10 min).
[Unit]
Description=Rocha Reis — backup diário

[Timer]
OnCalendar=*-*-* 03:15:00
RandomizedDelaySec=600
Persistent=true

[Install]
# Fase 18B-0: o backup só roda com o volume desbloqueado; o timer sobe junto com o rocha-reis.target
# (Persistent=true recupera a rodada perdida enquanto o volume estava bloqueado).
WantedBy=rocha-reis.target
