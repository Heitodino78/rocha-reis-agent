# REFERÊNCIA (Fases 13 e 17) — não instalado. Uma rodada do backup automático; acionada pelo timer.
[Unit]
Description=Rocha Reis — backup cifrado verificado (uma rodada)
OnFailure=rocha-reis-alerta@%n.service
# Fase 18B-0: SÓ com o volume LUKS de dados montado E conferido (rocha-reis-volume.service). BindsTo= no
# ponto de montagem: se o volume sair (desmontado/perdido), o serviço PARA em vez de gravar no disco de
# sistema. Volume ausente = falha de DEPENDÊNCIA (sem Restart= em ciclo, sem OnFailure=): nada sobe até o
# desbloqueio manual (deploy/scripts/rocha-reis-desbloquear). Não há entrada no fstab/crypttab de propósito.
Requires=rocha-reis-volume.service
After=rocha-reis-volume.service
BindsTo=var-lib-rocha\x2dreis\x2dagent.mount
After=var-lib-rocha\x2dreis\x2dagent.mount

[Service]
Type=oneshot
User=rocha-reis
Group=rocha-reis
WorkingDirectory=/opt/rocha-reis-agent/current
# Só o caminho do perfil vai na linha de comando; a chave fica em arquivo 0600 indicado no perfil.
ExecStart=/opt/rocha-reis-agent/current/.venv/bin/python -m rocha_reis_agent.ops backup-agendado --perfil /etc/rocha-reis-agent
ReadWritePaths=/var/lib/rocha-reis-agent
ReadOnlyPaths=/etc/rocha-reis-agent
RestrictAddressFamilies=AF_UNIX
PrivateNetwork=true
MemoryMax=512M
# Endurecimento (Fase 17): validado com `systemd-analyze verify` e `systemd-analyze security --offline`.
# Fase 18 (achado no systemd REAL: o watchdog abortou o worker com core dump): sem core dump — a memória do
# processo tem texto de conversas e segredos da instância.
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
UMask=0077
